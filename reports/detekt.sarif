              "shortDescription": {
                "text": "Duplicated `case` statements in a `when` expression detected. Both cases should be merged."
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://detekt.dev/potential-bugs.html#elsecaseinsteadofexhaustivewhen",
