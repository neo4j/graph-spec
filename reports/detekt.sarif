              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://detekt.dev/naming.html#enumnaming",
              "id": "detekt.naming.EnumNaming",
              "name": "EnumNaming",
              "shortDescription": {
                "text": "Enum names should follow the naming convention set in the projects configuration."
              }
            },
