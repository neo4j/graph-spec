              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://detekt.dev/naming.html#classnaming",
              "id": "detekt.naming.ClassNaming",
              "name": "ClassNaming",
              "shortDescription": {
                "text": "A class or object name should fit the naming pattern defined in the projects configuration."
              }
            },
