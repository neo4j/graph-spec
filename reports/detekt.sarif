              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://detekt.dev/naming.html#packagenaming",
              "id": "detekt.naming.PackageNaming",
              "name": "PackageNaming",
              "shortDescription": {
                "text": "Package names should match the naming convention set in the configuration."
              }
            },
