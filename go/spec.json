        "MAP": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "MAP"
                },
                "value": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/ExtensionValue"
                    }
                }
            },
            "required": [
                "type",
                "value"
            ],
            "additionalProperties": false
        },
        "STRING": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "STRING"
                },
                "value": {
                    "type": "string"
                }
            },
            "required": [
                "type",
                "value"
            ],
            "additionalProperties": false
        },
