                "suggested": {
                    "$ref": "#/$defs/Neo4jType"
                },
                "supported": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Neo4jType"
                    }
                },
                "dimension": {
                    "type": "integer",
                    "nullable": true
                },
                "custom": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/ExtensionValue"
                    }
                },
                "name": {
                    "type": "string",
                    "nullable": true
                }
            },
            "required": [],
            "additionalProperties": false
