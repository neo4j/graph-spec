            "oneOf": [
                {
                    "$ref": "#/$defs/BOOLEAN"
                },
                {
                    "$ref": "#/$defs/DOUBLE"
                },
                {
                    "$ref": "#/$defs/LIST"
                },
                {
                    "$ref": "#/$defs/LONG"
                },
                {
                    "$ref": "#/$defs/MAP"
                },
                {
                    "$ref": "#/$defs/STRING"
                }
