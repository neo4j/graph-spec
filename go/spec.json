                "properties": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "extensions": {
                    "$ref": "#/$defs/NodeConstraintExtensions"
                },
                "name": {
                    "type": "string",
                    "nullable": true
                }
