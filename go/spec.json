        "NodeConstraintExtensions": {
            "type": "object",
            "properties": {
                "custom": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/ExtensionValue"
                    }
                }
            },
            "required": [],
            "additionalProperties": false
        },
        "NodeExtensions": {
            "type": "object",
            "properties": {
                "custom": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/ExtensionValue"
                    }
                },
                "indexes": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/NodeIndex"
                    }
                },
                "display": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "#/$defs/NodeDisplay"
                        }
                    ]
                }
            },
            "required": [],
            "additionalProperties": false
        },
        "NodeIndex": {
            "type": "object",
            "properties": {
                "type": {
                    "$ref": "#/$defs/IndexType"
                },
                "labels": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "properties": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "options": {
                    "oneOf": [
                        {
                            "type": "null"
                        },
                        {
                            "$ref": "#/$defs/IndexOption"
