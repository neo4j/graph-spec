            "type": "object",
            "properties": {
                "type": {
                    "$ref": "#/$defs/Neo4jType"
                },
                "dimension": {
                    "type": "integer",
                    "nullable": true
                },
                "mustExist": {
                    "type": "boolean",
                    "nullable": true
