                "type": {
                    "type": "string",
                    "const": "DOUBLE"
                },
                "value": {
                    "type": "number"
                }
            },
            "required": [
                "type",
                "value"
            ],
            "additionalProperties": false
        },
        "LIST": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "LIST"
                },
                "value": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/ExtensionValue"
                    }
                }
            },
            "required": [
                "type",
                "value"
            ],
            "additionalProperties": false
        },
        "LONG": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "LONG"
                },
                "value": {
                    "type": "integer"
                }
            },
            "required": [
                "type",
                "value"
            ],
            "additionalProperties": false
