                "custom": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/ExtensionValue"
                    }
                },
                "tables": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/Table"
                    }
                },
                "mappings": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Mapping"
                    }
                }
            },
            "required": [],
            "additionalProperties": false
