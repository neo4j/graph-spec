        "BOOLEAN": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "BOOLEAN"
                },
                "value": {
                    "type": "boolean"
                }
            },
            "required": [
                "type",
                "value"
            ],
            "additionalProperties": false
        },
        "DOUBLE": {
            "type": "object",
