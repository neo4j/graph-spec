                "properties": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/Property"
                    }
                },
                "constraints": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/NodeConstraint"
                    }
                },
                "extensions": {
                    "$ref": "#/$defs/NodeExtensions"
                },
                "name": {
                    "type": "string",
                    "nullable": true
                },
                "description": {
                    "type": "string"
                },
                "aliases": {
