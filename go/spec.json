                "type": {
                    "type": "string"
                },
                "from": {
                    "$ref": "#/$defs/RelationshipTarget"
                },
                "to": {
                    "$ref": "#/$defs/RelationshipTarget"
                },
                "properties": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/Property"
                    }
                },
                "constraints": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/RelationshipConstraint"
                    }
                },
                "extensions": {
                    "$ref": "#/$defs/RelationshipExtensions"
                },
                "name": {
                    "type": "string",
                    "nullable": true
                },
                "description": {
                    "type": "string"
                },
                "aliases": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "reference": {
                    "type": "string"
                }
            },
            "required": [
                "type",
                "from",
                "to"
            ],
            "additionalProperties": false
        },
