                "implied": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "optional": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "extensions": {
                    "$ref": "#/$defs/LabelsExtensions"
