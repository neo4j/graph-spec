            "type": "object",
            "properties": {
                "node": {
                    "type": "string"
                },
                "label": {
                    "type": "string"
                },
                "count": {
                    "type": "integer"
                },
                "min_count": {
                    "type": "integer"
                },
                "max_count": {
                    "type": "integer"
                }
            },
            "required": [],
            "additionalProperties": false
        },
        "RelationshipConstraint": {
            "type": "object",
            "properties": {
                "type": {
                    "$ref": "#/$defs/ConstraintType"
                },
                "properties": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "extensions": {
                    "$ref": "#/$defs/RelationshipConstraintExtensions"
                },
                "name": {
                    "type": "string",
                    "nullable": true
                }
            },
            "required": [
                "type",
                "properties"
            ],
            "additionalProperties": false
