                "columns": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "custom": {
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/$defs/ExtensionValue"
                    }
                }
            },
            "required": [
