            "type": "string",
            "enum": [
                "FULLTEXT",
                "POINT",
                "RANGE",
                "TEXT",
                "VECTOR",
                "LOOKUP"
            ]
        },
        "IndexOption": {
            "oneOf": [
                {
                    "$ref": "#/$defs/FULLTEXT"
                },
                {
                    "$ref": "#/$defs/POINT"
                },
                {
                    "$ref": "#/$defs/VECTOR"
                }
            ],
            "discriminator": {
                "propertyName": "type"
            }
        },
