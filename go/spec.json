                "type": {
                    "type": "string",
                    "const": "POINT"
                },
                "spatial.cartesian.min": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "spatial.cartesian.max": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "spatial.cartesian-3d.min": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "spatial.cartesian-3d.max": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "spatial.wgs-84.min": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "spatial.wgs-84.max": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "spatial.wgs-84-3d.min": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "spatial.wgs-84-3d.max": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                }
            },
            "required": [
                "type"
            ],
            "additionalProperties": false
        },
        "VECTOR": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "VECTOR"
                },
                "vector.dimensions": {
                    "type": "integer",
                    "nullable": true
                },
                "vector.similarity_function": {
                    "type": "string"
                },
                "vector.default_search_expansion_factor": {
                    "type": "number",
                    "nullable": true
                },
                "vector.quantization.enabled": {
                    "type": "boolean"
                },
                "vector.quantization.type": {
                    "type": "string"
                },
                "vector.hnsw.m": {
                    "type": "integer"
                },
                "vector.hnsw.ef_construction": {
                    "type": "integer"
                }
            },
            "required": [
                "type"
            ],
            "additionalProperties": false
        },
