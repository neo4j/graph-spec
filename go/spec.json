                "unique": {
                    "type": "boolean",
                    "nullable": true
                },
                "key": {
                    "type": "boolean",
                    "nullable": true
                },
                "extensions": {
                    "$ref": "#/$defs/PropertyExtensions"
                },
                "name": {
                    "type": "string",
                    "nullable": true
                },
                "description": {
                    "type": "string"
                },
                "reference": {
                    "type": "string"
                },
                "pattern": {
                    "type": "string"
                },
                "one_of": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [],
            "additionalProperties": false
        },
        "Neo4jType": {
            "type": "string",
            "enum": [
                "ANY",
                "LIST<ANY>",
                "BOOLEAN",
                "LIST<BOOLEAN>",
                "DATE",
                "LIST<DATE>",
                "DURATION",
                "LIST<DURATION>",
                "FLOAT32",
                "LIST<FLOAT32>",
                "FLOAT",
                "LIST<FLOAT>",
                "INTEGER8",
                "LIST<INTEGER8>",
                "INTEGER16",
                "LIST<INTEGER16>",
                "INTEGER32",
                "LIST<INTEGER32>",
                "INTEGER",
                "LIST<INTEGER>",
                "LOCAL DATETIME",
                "LIST<LOCAL DATETIME>",
                "LOCAL TIME",
                "LIST<LOCAL TIME>",
                "POINT",
                "LIST<POINT>",
                "STRING",
                "LIST<STRING>",
                "VECTOR<FLOAT>",
                "VECTOR<FLOAT32>",
                "VECTOR<INTEGER>",
                "VECTOR<INTEGER32>",
                "VECTOR<INTEGER16>",
                "VECTOR<INTEGER8>",
                "ZONED DATETIME",
                "LIST<ZONED DATETIME>",
                "ZONED TIME",
                "LIST<ZONED TIME>",
                "UUID"
