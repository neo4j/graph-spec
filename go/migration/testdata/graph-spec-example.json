{
  "version": "4.0.0",
  "name": "movies",
  "description": "Movie domain ontology",
  "nodes": {
    "movie": {
      "label": "Movie",
      "properties": {
        "id": { "type": "UUID", "unique": true },
        "title": { "type": "STRING" },
        "released": { "type": "ZONED DATETIME" },
        "embedding": { "type": "VECTOR<FLOAT32>", "dimension": 1536 }
      },
      "constraints": {
        "c0": { "type": "EXISTS", "properties": ["title"], "name": "exists_movie_title" }
      }
    },
    "person": {
      "labels": { "identifier": "Person", "implied": ["Actor"], "optional": ["Director"] },
      "properties": {
        "name": { "type": "STRING" }
      }
    }
  },
  "relationships": {
    "ACTED_IN": {
      "type": "ACTED_IN",
      "from": { "node": "person", "label": "Person" },
      "to": { "node": "movie", "label": "Movie" },
      "properties": {
        "roles": { "type": "LIST<STRING>" }
      }
    }
  }
}
