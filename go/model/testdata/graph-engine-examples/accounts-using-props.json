{
  "schema": "https://neo4j.com/ontology-graph-spec/1.0.0/",
  "version": "1.0.0",
  "id": "accounts-using-props",
  "description": "This model corresponds to the graph engine model here: https://github.com/neo-technology/ge-test-data/blob/main/fraud-detection-training/fraud-mono.json. This model is an example that could in the future be used in an API. This model would not be sufficient for use in the UI - it would additionally need a `tables` section to define the SQL/snowflake/etc source tables, columns & types for display in the UI.",
  "nodes": {
    "Account": {
      "label": "Account",
      "properties": {
        "email": {
          "type": "STRING"
        },
        "name": {
          "type": "STRING"
        },
        "a_id": {
          "type": "INTEGER"
        }
      }
    }
  },
  "relationships": {
    "TRANSACTION": {
      "type": "TRANSACTION",
      "from": {
        "node": "Account"
      },
      "to": {
        "node": "Account"
      },
      "properties": {
        "tx_id": {
          "type": "INTEGER"
        },
        "date": {
          "type": "DATE"
        },
        "amount": {
          "type": "FLOAT"
        }
      }
    }
  },
  "extensions": {
    "mappings": [
      {
        "type": "NODE",
        "node": "Account",
        "table": "accounts",
        "properties": {
          "email": {
            "column": "email"
          },
          "name": {
            "column": "name"
          },
          "a_id": {
            "column": "id"
          }
        },
        "keyProperties": [
          "a_id"
        ]
      },
      {
        "type": "RELATIONSHIP",
        "relationship": "TRANSACTION",
        "table": "transactions",
        "from_node": [
          {
            "nodeKeyProperty": "a_id",
            "relationshipColumn": "to_id"
          }
        ],
        "to_node": [
          {
            "nodeKeyProperty": "a_id",
            "relationshipColumn": "from_id"
          }
        ],
        "properties": {
          "tx_id": {
            "column": "id"
          },
          "date": {
            "column": "created_at"
          },
          "amount": {
            "column": "amount"
          }
        },
        "keyProperties": [
          "tx_id"
        ]
      }
    ]
  }
}
